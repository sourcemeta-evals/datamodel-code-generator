{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ConstrainedString": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^[a-z]+$"
    },
    "ConstrainedInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
