{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$recursiveAnchor": true,
  "type": "object",
  "properties": {
    "rootName": { "type": "string" },
    "tree": { "$ref": "#/$defs/TreeNode" }
  },
  "$defs": {
    "TreeNode": {
      "$recursiveAnchor": true,
      "type": "object",
      "properties": {
        "nodeName": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$recursiveRef": "#" }
        }
      }
    }
  }
}
