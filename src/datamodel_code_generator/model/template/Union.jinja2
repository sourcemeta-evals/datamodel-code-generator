{%- if alias_syntax == 'statement' %}
{%- if fields|length > 1 %}
type {{ class_name }} = Union[
{%- for field in fields %}
    '{{ field.name }}',
{%- endfor %}
]{% elif fields %}
type {{ class_name }} = {{ fields[0].name }}{% else %}
type {{ class_name }} = {{ base_class }}{% endif %}
{%- elif alias_syntax == 'alias_type' %}
{%- if fields|length > 1 %}
{{ class_name }} = TypeAliasType("{{ class_name }}", Union[
{%- for field in fields %}
    '{{ field.name }}',
{%- endfor %}
]){% elif fields %}
{{ class_name }} = TypeAliasType("{{ class_name }}", {{ fields[0].name }}){% else %}
{{ class_name }} = TypeAliasType("{{ class_name }}", {{ base_class }}){% endif %}
{%- else %}
{%- if fields|length > 1 %}
{{ class_name }}: TypeAlias = Union[
{%- for field in fields %}
        '{{ field.name }}',
{%- endfor %}
    ]{% elif fields %}
{{ class_name }}: TypeAlias = {{ fields[0].name }}{% else %}
{{ class_name }}: TypeAlias = {{ base_class }}{% endif %}
{%- endif %}
